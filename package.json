{
  "name": "tank-me-later-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w tank-me-later",
    "dev:watch": "npm run dev -w title-watch",
    "build": "npm run build -w tank-me-later && npm run build -w title-watch",
    "build:tank-me-later": "npm run build -w tank-me-later",
    "build:title-watch": "npm run build -w title-watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandanq2/tank-me-later.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/brandanq2/tank-me-later/issues"
  },
  "homepage": "https://github.com/brandanq2/tank-me-later#readme",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
